{
    "name": "raxos/openapi",
    "description": "An OpenAPI generator for Raxos.",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "type": "library",
    "authors": [
        {
            "name": "Bas Milius",
            "email": "bas@mili.us"
        }
    ],
    "autoload": {
        "psr-4": {
            "Raxos\\OpenAPI\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "symlink": true
        }
    ],
    "require": {
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "jetbrains/phpstorm-attributes": "^1.2",
        "php": ">=8.5",
        "raxos/collection": "*",
        "raxos/contract": "*",
        "raxos/database": "*",
        "raxos/error": "*",
        "raxos/foundation": "*",
        "raxos/http": "*",
        "raxos/router": "*",
        "raxos/search": "*",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "opis/json-schema": "^2.6",
        "pestphp/pest": "^5.0"
    },
    "autoload-dev": {
        "classmap": [
            "tests/Fixtures/"
        ]
    },
    "scripts": {
        "test": "pest --compact"
    }
}
